# ── Kibana ───────────────────────────────────────────────────────────────────
KIBANA_URL=https://<your-cluster>.kb.<region>.gcp.cloud.es.io:9243

# ── Elasticsearch ────────────────────────────────────────────────────────────
SYNTHETICS_ES_URL=https://<your-cluster>.<region>.gcp.cloud.es.io:443
SYNTHETICS_ES_KEY=<your-api-key>
SYNTHETICS_ES_DEBUG=false

# ── Monitor identity ──────────────────────────────────────────────────────────
# MONITOR_ID: the config_id returned by POST /api/synthetics/monitors
MONITOR_ID=<uuid-from-kibana>
MONITOR_NAME="My Monitor"
MONITOR_SCHEDULE=10

# ── Location ──────────────────────────────────────────────────────────────────
# MONITOR_LOCATION_NAME must match the "Location name" column in
# Observability → Settings → Private Locations (see private_location.png)
MONITOR_LOCATION_NAME=CI / GitHub Actions
MONITOR_LOCATION_GEO="48.8566, 2.3522"

# ── Metadata (optional) ───────────────────────────────────────────────────────
MONITOR_TAGS=ci,synthetics
MONITOR_SERVICE=my-service
MONITOR_SPACE=default

# ── Runner options (optional) ─────────────────────────────────────────────────
SYNTHETICS_HEADLESS=true                  # set to 'false' for headed debug mode
SYNTHETICS_SCREENSHOTS=on                 # 'on' | 'off' | 'only-on-failure'
SYNTHETICS_AGENT_VERSION=9.1.0            # heartbeat agent version in ES docs
